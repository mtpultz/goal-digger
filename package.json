{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:check": "prettier --check resources/",
        "format:write": "prettier --write resources/",
        "lint:check": "eslint .",
        "lint:check:errors": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "spell:check": "cspell \"./**/*.*\" --words-only --unique --gitignore",
        "spell:check:errors": "cspell \"./**/*.*\" --words-only --unique --gitignore --quiet",
        "prepare": "husky",
        "setup:mcp": "bash scripts/setup-mcp.sh"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.0.13",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "cspell": "^9.0.2",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^1.2.0",
        "lint-staged": "^16.1.2",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.3.5",
        "typescript": "^5.8.3",
        "vite": "^6.2.4"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.1.1",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-slot": "^1.2.3",
        "@shadcn/ui": "^0.0.4",
        "@vitejs/plugin-react": "^4.6.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.525.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.60.0",
        "react-router-dom": "^7.6.3",
        "tailwind-merge": "^3.3.1",
        "zod": "^4.0.5"
    }
}
